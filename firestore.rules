rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
    function validEmail(value) {
      return value is string
        && value.size() >= 5
        && value.size() <= 254
        && value.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$');
    }
    function validNonBlankText(value, maxSize) {
      return value is string
        && value.size() > 0
        && value.size() <= maxSize
        && value.matches('.*\\S.*');
    }
    function validHttpUrl(value) {
      return value is string
        && value.size() <= 2048
        && value.matches('^https://[^\\s/]+(/[^\\s]*)?$');
    }
    function validUpdate(data) {
      return data.keys().hasOnly([
        'title_en','title_bn','title','slug','excerpt_en','excerpt_bn','excerpt',
        'body_en','body_bn','body','category','media_type','image_url','video_url',
        'external_url','published','published_at','created_at','updated_at'
      ])
      && (
        (data.keys().hasAny(['title_en']) && validNonBlankText(data.title_en, 180))
        || (data.keys().hasAny(['title_bn']) && validNonBlankText(data.title_bn, 180))
        || (data.keys().hasAny(['title']) && validNonBlankText(data.title, 180))
      )
      && data.published is bool
      && (!data.keys().hasAny(['title_en']) || (data.title_en is string && data.title_en.size() <= 180))
      && (!data.keys().hasAny(['title_bn']) || (data.title_bn is string && data.title_bn.size() <= 180))
      && (!data.keys().hasAny(['title']) || (data.title is string && data.title.size() <= 180))
      && (!data.keys().hasAny(['slug']) || data.slug == null || (data.slug is string && data.slug.size() <= 180))
      && (!data.keys().hasAny(['excerpt_en']) || data.excerpt_en == null || (data.excerpt_en is string && data.excerpt_en.size() <= 1000))
      && (!data.keys().hasAny(['excerpt_bn']) || data.excerpt_bn == null || (data.excerpt_bn is string && data.excerpt_bn.size() <= 1000))
      && (!data.keys().hasAny(['excerpt']) || data.excerpt == null || (data.excerpt is string && data.excerpt.size() <= 1000))
      && (!data.keys().hasAny(['body_en']) || data.body_en == null || (data.body_en is string && data.body_en.size() <= 20000))
      && (!data.keys().hasAny(['body_bn']) || data.body_bn == null || (data.body_bn is string && data.body_bn.size() <= 20000))
      && (!data.keys().hasAny(['body']) || data.body == null || (data.body is string && data.body.size() <= 20000))
      && (!data.keys().hasAny(['category']) || data.category == null || (data.category is string && data.category.size() <= 80))
      && (!data.keys().hasAny(['media_type']) || data.media_type == null || (data.media_type is string && data.media_type.size() <= 40))
      && (!data.keys().hasAny(['image_url']) || data.image_url == null || validHttpUrl(data.image_url))
      && (!data.keys().hasAny(['video_url']) || data.video_url == null || validHttpUrl(data.video_url))
      && (!data.keys().hasAny(['external_url']) || data.external_url == null || validHttpUrl(data.external_url));
    }

    match /website_updates/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update: if isAdmin() && validUpdate(request.resource.data);
      allow delete: if isAdmin();
    }

    match /website_subscribers/{id} {
      function validSubscriber(data) {
        return validEmail(data.email)
          && data.source is string && data.source.size() > 0 && data.source.size() <= 80
          && data.status == 'active'
          && data.keys().hasOnly(['email','source','status','created_at','updated_at'])
          && data.created_at == request.time
          && data.updated_at == request.time;
      }
      allow create: if validSubscriber(request.resource.data);
      allow update: if request.resource.data.email == resource.data.email
        && request.resource.data.source == resource.data.source
        && request.resource.data.status == 'active'
        && request.resource.data.created_at == resource.data.created_at
        && request.resource.data.updated_at == request.time
        && request.resource.data.keys().hasOnly(['email','source','status','created_at','updated_at']);
      allow read, delete: if isAdmin();
    }
    match /website_contact_messages/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','email','phone','subject','message','source','status','created_at'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 100
        && validEmail(request.resource.data.email)
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 30
        && request.resource.data.subject is string && request.resource.data.subject.size() <= 180
        && request.resource.data.message is string && request.resource.data.message.size() >= 5 && request.resource.data.message.size() <= 5000
        && request.resource.data.source is string && request.resource.data.source.size() > 0 && request.resource.data.source.size() <= 80
        && request.resource.data.status == 'new'
        && request.resource.data.created_at == request.time;
      allow read, update, delete: if isAdmin();
    }
    match /website_update_likes/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['update_id','visitor_id','created_at'])
        && request.resource.data.update_id is string && request.resource.data.update_id.size() > 0 && request.resource.data.update_id.size() <= 180
        && request.resource.data.visitor_id is string && request.resource.data.visitor_id.size() >= 8 && request.resource.data.visitor_id.size() <= 128
        && request.resource.data.created_at == request.time
        && exists(/databases/$(database)/documents/website_updates/$(request.resource.data.update_id))
        && get(/databases/$(database)/documents/website_updates/$(request.resource.data.update_id)).data.published == true
        && id == request.resource.data.update_id + '_' + request.resource.data.visitor_id;
      allow update: if false;
      allow delete: if isAdmin();
    }
    match /website_update_comments/{id} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['update_id','name','email','comment','status','created_at'])
        && request.resource.data.update_id is string && request.resource.data.update_id.size() > 0 && request.resource.data.update_id.size() <= 180
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 100
        && (request.resource.data.email == null || validEmail(request.resource.data.email))
        && request.resource.data.comment is string && request.resource.data.comment.size() >= 2 && request.resource.data.comment.size() <= 2000
        && request.resource.data.status == 'pending'
        && request.resource.data.created_at == request.time
        && exists(/databases/$(database)/documents/website_updates/$(request.resource.data.update_id))
        && get(/databases/$(database)/documents/website_updates/$(request.resource.data.update_id)).data.published == true;
      allow update, delete: if isAdmin();
    }
  }
}
